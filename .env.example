# 观复环境变量示例 —— 复制为 .env 或直接 export；真实值绝不提交
# .gitignore 已排除 .env / .env.*

# 服务监听与数据
GUANFU_LISTEN=:8788
GUANFU_DB=./data/guanfu.db
GUANFU_TZ=Asia/Shanghai
GUANFU_SYNC_ENABLED=1

# 数据源凭据（按需启用；ENABLED=1 才进入调度）
HUOZHI_BASE_URL=https://huozhi.example.com
HUOZHI_API_KEY=replace-me
HUOZHI_ENABLED=1
HUOZHI_INTERVAL=30m

# M2 数据源（配了 BASE_URL 即自动启用；*=1/0 可显式覆盖）
MUJIAN_BASE_URL=https://mujian.example.com
# MUJIAN_API_KEY=replace-me            # 可选：未配置 token 的 mujian 实例放通
# MUJIAN_LOOKBACK_DAYS=365
ZHICHANG_BASE_URL=http://127.0.0.1:18788
# ZHICHANG_METRICS=step_count,active_energy,heart_rate,sleep_analysis,body_mass,body_fat_percentage,oxygen_saturation,heart_rate_variability
# ZHICHANG_LOOKBACK_DAYS=30
DAWARICH_BASE_URL=https://dawarich.example.com
# DAWARICH_API_KEY=replace-me
# DAWARICH_LOOKBACK_DAYS=30
BILI_HISTORY_BASE_URL=http://127.0.0.1:8080
# BILI_HISTORY_LOOKBACK_DAYS=90

# M3 数据源（配了 BASE_URL 即自动启用；*=1/0 可显式覆盖）
# diarum：API_KEY 三种形态——直接贴 JWT（30 天有效，过期需更新）、
# "用户名:密码"（适配器自动登录换 JWT 并缓存，无需人工轮换）、
# 或设置页签发的 API token（MCP 同款，走公开接口同步）。
DIARUM_BASE_URL=https://diarum.example.com
# DIARUM_API_KEY=replace-me            # JWT / 用户名:密码 / API token
# DIARUM_ENABLED=0
# DIARUM_LOOKBACK_DAYS=365
# immich：只读 API key（asset.read/view/download/statistics），建议命名 guanfu-readonly。
IMMICH_BASE_URL=https://immich.example.com
# IMMICH_API_KEY=replace-me
# IMMICH_ENABLED=0
# IMMICH_LOOKBACK_DAYS=365

# M4 增值源（配了 BASE_URL 即自动启用；*=1/0 可显式覆盖）
# qiansi：人情往来（往来事件/礼金/纪念日）。QIANSI_TOKEN 未配置时服务端放行。
QIANSI_BASE_URL=http://127.0.0.1:8080
# QIANSI_API_KEY=replace-me            # 服务端配了 QIANSI_TOKEN 才需要（Bearer）
# QIANSI_LOOKBACK_DAYS=180
# shenshi：任务完成/每日复盘/习惯打卡。SHENSHI_TOKEN 未配置时服务端放行。
SHENSHI_BASE_URL=http://127.0.0.1:8787
# SHENSHI_API_KEY=replace-me           # 服务端配了 SHENSHI_TOKEN 才需要（Bearer）
# SHENSHI_LOOKBACK_DAYS=90
# liuxia：朝霞/晚霞预报（零鉴权，无需 key）。
LIUXIA_BASE_URL=http://127.0.0.1:8080
# LIUXIA_LOOKBACK_DAYS=30
# qingye：园艺（植物日记 + 养护记录）。零鉴权，无需 key。
# 上游没有任何日期过滤参数，增量靠倒序翻页 + 游标水位（游标是 unix 秒，不是日期）。
QINGYE_BASE_URL=https://qingye.example.com
# QINGYE_LOOKBACK_DAYS=365

# 只读 MCP server（挂在 /mcp，另有 `guanfu mcp` 走 stdio）。
# 默认开启：工具全部只读，暴露面与已有的 /api/v1/* 同级（本就无鉴权的内网服务）。
# 若要用反向代理把它放出去，务必配 token —— 非环回 Host + 环回监听会被
# DNS rebinding 保护判 403，配了 token 时代码会自动放行该场景。
# GUANFU_MCP_ENABLED=0
# GUANFU_MCP_TOKEN=replace-me          # 客户端需带 Authorization: Bearer <token>

# ---------- 认证方式（可选，默认按源类型推断）----------
# 取值：none / api_key / bearer / basic / jwt / token
# 不配时按源推断：huozhi+immich=api_key、mujian=jwt、其余=bearer（见 internal/config/auth.go）。
# api_key 请求头按源区分：huozhi=X-API-Key、immich=x-api-key、mujian=X-Auth-Token。
#   HUOZHI_AUTH=bearer
#   DIARUM_AUTH=bearer
# basic 的凭据写成 "用户名:密码"（也接受直接给 base64）。

# ---------- 设置页凭据的加密密钥 ----------
# 在页面里保存的 token 会以 AES-256-GCM 密文落库（形如 enc:v1:...）。
# 密钥优先级：本变量 > <GUANFU_DB>.key（不存在则自动生成，0600）。
# 32 字节 base64 直用；其它长度按 SHA-256 派生（所以任意口令都能用）。
# 换密钥后旧密文解不开，设置页会标红提示重填。
# GUANFU_SECRET_KEY=

# ---------- 通知渠道（也可在设置页配，页面优先）----------
# apprise：Apprise API。Key 存在时走 POST /notify/{key}；Key 为空则走 POST /notify + urls 列表
#   （Targets 空格/逗号/换行分隔）。
APPRISE_BASE_URL=http://apprise.local:8000
# APPRISE_KEY=guanfu
# APPRISE_TARGETS=tgram://bot/chat  mailto://user:pass@gmail.com
# APPRISE_API_KEY=replace-me
# APPRISE_AUTH=none
# APPRISE_ENABLED=0

# 同步失败推送总开关默认关闭，**只在设置页里**打开（不设环境变量：它是单一开关，
# 两个真值来源只会互相打架）。打开后仅在该源「由正常转失败」时推一次，
# 同一源 6 小时内去重；恢复后再次失败才会再推。
