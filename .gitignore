bin/
data/
web/node_modules/
web/build/
web/.svelte-kit/
*.db
*.db-wal
*.db-shm
.DS_Store

# 前端产物不进版本控制：internal/web/dist 走脚本生成，仓库里只留一个 .gitkeep
# 占位（否则 //go:embed all:dist 在没有产物的机器上直接编译不过）。
internal/web/dist/*
!internal/web/dist/.gitkeep

# 凭据文件绝不入库（真实配置只走环境变量 / docker -e）
.env
.env.*
!.env.example
